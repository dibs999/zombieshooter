; Engine configuration file.
; Best edited using Godot 4.3+ editor or text editor.

config_version=5

[application]

config/name="BUNKER 115: Undead Protocol"
config/description="Call of Duty Zombies inspired survival FPS built in Godot 4 with Blender 3D models."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

SettingsManager="*res://scripts/autoload/settings_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
WeaponDB="*res://scripts/autoload/weapon_db.gd"
GameManager="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

