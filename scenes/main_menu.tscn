[node name="GuideText" type="Label" parent="UI/Card/VBox/GuideBox"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "• RUNDEN-SYSTEM: Zombie-HP steigt jede Runde (150 -> 950 -> x1.1). Alle 5 Runden: Höllenhunde-Runde (+Max Ammo am Ende)! Ab Runde 8: Gepanzerte Brutes.
• PUNKTE: Treffer +10, Kill +60, Kopfschuss +100, Messer +130, Barrikade reparieren +10.
• TÜREN & STROM: Kaufe neue Bereiche frei und aktiviere den Stromschalter im Reaktor-Raum, um Perks, Elektro-Falle & Pack-a-Punch einzuschalten!
• PERK-A-COLA: Quick Revive (500, Solo-Selbstwiederbelebung), Juggernog (2500, 250 HP), Double Tap II (2000, 2x Schaden + Feuerrate), Speed Cola (3000, 2x Nachladen), Stamin-Up (2000, Sprint-Boost).
• MYSTERY BOX ($950) & PACK-A-PUNCH ($5000): Ziehe seltene Waffen wie MG42 oder die Ray Gun und veredele sie mit Runen-Tarnung & extremer Durchschlagskraft.
• STEUERUNG: WASD Bewegen | Shift Sprint | C Ducken | Maus Zielen/Schießen | R Nachladen | E/F Interagieren | Q / 1-2 Waffe | V Messer | G Granate | Esc Pause"
autowrap_mode = 3

