[node name="GuideText" type="Label" parent="UI/Card/VBox/GuideBox"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "• RUNDEN-SYSTEM: Zombie-HP steigt jede Runde (150 -> 950 -> x1.1). 5 Zombie-Typen (mit Abtrennungs-Gore), alle 5 Runden: Höllenhunde-Runde (+Max Ammo)! Ab Runde 8: Gepanzerter Panzersoldat-Boss mit zerbrechlicher Rüstung & Flammenwerfer.
• PUNKTE & ZONEN: Treffer +10, Kill +60, Kopfschuss +100, Messer +130, Barrikade reparieren +10. 5 Zonen inkl. Motorpool Yard freischaltbar — Stromschalter im Reaktorraum aktiviert Perks, Elektro-/Feuer-Fallen, Teleporter & Pack-a-Punch.
• PERK-A-COLA (4er-Limit) & WUNDERFIZZ: Quick Revive (500), Juggernog (2500), Double Tap II (2000), Speed Cola (3000), Stamin-Up (2000), Deadshot Daiquiri (1500), Mule Kick (4000, 3. Waffe), PhD Flopper (2000, Slide-Nuke), Electric Cherry (2000) + Der Wunderfizz (1500).
• MYSTERY BOX ($950), PACK-A-PUNCH ($5000) & QUEST: Ziehe MG42, Ray Gun oder die Wunderwaffe DG-2. Schließe 'Operation Element 115' (Terminal im Nordhof) & 3 Musik-Teddies ab für alle 9 Perks + Wunderwaffe DG-3 JZ!
• STEUERUNG: WASD Bewegen | Shift Sprint | Shift+C Sprint-Slide | Maus Zielen/Schießen | R Nachladen | E/F Interagieren | Q / 1-3 Waffe | V Messer | G Granate | Esc Pause"
autowrap_mode = 3

