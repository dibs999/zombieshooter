func create_weapon_state(weapon_id: String, packed: bool = false) -> Dictionary:
	var base: Dictionary = WEAPON_DATA.get(weapon_id, WEAPON_DATA["m1911"])
	var mag_cap: int = int(base["pap_mag"] if packed else base["mag_size"])
	var res_cap: int = int(base["pap_reserve"] if packed else base["reserve_max"])
	return {
		"id": weapon_id,
		"packed": packed,
		"mag": mag_cap,
		"reserve": res_cap,
		"mag_cap": mag_cap,
		"reserve_cap": res_cap,
	}


func get_display_name(state: Dictionary) -> String:
	var base: Dictionary = WEAPON_DATA.get(state.get("id", "m1911"), WEAPON_DATA["m1911"])
	return str(base["pap_name"] if state.get("packed", false) else base["name"])


func get_stat(state: Dictionary, key: String):
	var base: Dictionary = WEAPON_DATA.get(state.get("id", "m1911"), WEAPON_DATA["m1911"])
	var packed: bool = bool(state.get("packed", false))
	if key == "damage" and packed:
		return base["pap_damage"]
	if key == "is_explosive":
		return bool(base["pap_explosive"]) if packed else bool(base["is_explosive"])
	if key == "sfx":
		return str(base["pap_sfx"]) if packed else str(base["sfx"])
	return base.get(key)


func pick_random_box_weapon(exclude_ids: Array[String] = []) -> String:
	var pool: Array[String] = []
	for wid in WEAPON_DATA.keys():
		if wid in exclude_ids:
			continue
		var w := int(WEAPON_DATA[wid]["box_weight"])
		for _i in range(w):
			pool.append(wid)
	if pool.is_empty():
		return "raygun"
	return pool[randi() % pool.size()]
